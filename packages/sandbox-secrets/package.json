{
  "name": "@background-agents/sandbox-secrets",
  "version": "0.1.0",
  "description": "Keep credentials out of Daytona sandboxes: mount Daytona secrets, whose placeholders the egress proxy swaps for the real value",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@daytonaio/sdk": ">=0.217.0"
  },
  "devDependencies": {
    "@daytonaio/sdk": "^0.217.0",
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "daytona",
    "secrets",
    "sandbox"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
