{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/refresh-claude-creds",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/agent-lifecycle",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/daily-credits",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/refresh-codex-creds",
      "schedule": "0 * * * *"
    }
  ]
}
